# Copy to .env and fill in ONLY the provider you want to use.
# The test suite and the eval never read these: they run without credentials.

# IBM watsonx.ai (Lite plan works)
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Groq (free tier)
GROQ_API_KEY=

# Hugging Face Inference Providers
HF_TOKEN=

# Ollama (local, no key)
OLLAMA_HOST=http://localhost:11434

# Optional: override the model id used for each cost tier (any backend)
# NLSQL_MODEL_SMALL=
# NLSQL_MODEL_LARGE=
